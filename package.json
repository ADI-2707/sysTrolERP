{
  "name": "systrol-erp",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev:frontend",
    "dev:backend": "python backend/manage.py runserver 0.0.0.0:8000",
    "dev:frontend": "npm run dev --workspace=@systrol/web",
    "build": "npm run build --workspaces",
    "build:ui": "npm run build --workspace=@systrol/ui",
    "build:web": "npm run build --workspace=@systrol/web",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && coverage run -m pytest && coverage report --fail-under=85",
    "test:frontend": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "lint": "python scripts/check_no_comments.py",
    "seed": "python backend/manage.py seed_demo",
    "seed:fresh": "python backend/manage.py seed_demo --clear",
    "migrate": "python backend/manage.py migrate"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@playwright/test": "^1.65.1",
    "husky": "^9.1.7",
    "typescript": "^5.7.3"
  }
}
